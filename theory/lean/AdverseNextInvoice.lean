theorem adverseNext_whole_rational_invoice :
    rationalInvoice adverseNextProposal = (646625512555167/20000000 : ℚ) := by
  unfold rationalInvoice
  rw [adverseNext_whole_cache_exact,List.sum_toFinset _ adverseNext_whole_cache_nodup]
  norm_num [adverseNext_whole_cache,rationalActionPrice]
