theorem favorableNext_whole_cache_nodup : favorableNext_whole_cache.Nodup := by
  apply List.Nodup.of_map (f := pathCode)
  have hc : (favorableNext_whole_cache.map pathCode).IsChain (· < ·) := by decide +kernel
  exact hc.pairwise.nodup
#check favorableNext_whole_cache_nodup

theorem favorableNext_whole_cache_exact :
    pathHistoryCache favorableNextProposal = favorableNext_whole_cache.toFinset := by
  decide +kernel
#check favorableNext_whole_cache_exact

theorem favorableNext_whole_rational_invoice :
    rationalInvoice favorableNextProposal = (646625512555167/20000000 : ℚ) := by
  unfold rationalInvoice
  rw [favorableNext_whole_cache_exact,List.sum_toFinset _ favorableNext_whole_cache_nodup]
  norm_num [favorableNext_whole_cache,rationalActionPrice]
#check favorableNext_whole_rational_invoice

theorem favorableNext_whole_physical_invoice :
    completedBill unitRoleUnused favorableNextProposal = (646625512555167/20000000 : ℝ) := by
  rw [completed_bill_rational_invoice,favorableNext_whole_rational_invoice]
  norm_num

